# ==========================================================================
# Ichikara Management System — konfigurasi Apache (cPanel) untuk SPA.
# File ini otomatis tersalin ke dist/ saat `npm run build`.
# Catatan: jika di-deploy ke SUBFOLDER (mis. domain.com/ichikara/), ganti
# "RewriteBase /" menjadi "RewriteBase /ichikara/" dan set `base` di vite.config.js.
# ==========================================================================

# --- SPA fallback: arahkan semua route ke index.html (React Router) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Biarkan file & folder yang benar-benar ada (aset, gambar, dll) dilayani apa adanya
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Selain itu, kembalikan index.html agar routing ditangani di sisi React
  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching: aset ber-hash boleh lama, index.html jangan di-cache ---
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Kompresi gzip (mempercepat load) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
